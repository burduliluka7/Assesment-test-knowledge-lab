      "surface_form": "Virtual Node Graph Neural Network for Full Phonon Prediction"
    },
    {
      "id": "clai_00095",
      "type": "claim",
      "surface_form": "Conservative PET-OAM models achieve state-of-the-art performance on phonon tasks in matbench-discovery and the best overall accuracy in predicting shear modulus among tested models."
    },
    {
      "id": "clai_00098",
      "type": "claim",
      "surface_form": "Central finite differences can more than halve the error for non-equivariant models on phonon calculations by averaging out inconsistencies between symmetry-equivalent displacements, and O(3)-averaging increases symmetric structures to 77% with symprec 0.01 Å in the non-conservative case."
    },
    {
      "id": "clai_00099",
      "type": "claim",
      "surface_form": "Accurate conservative, rotationally unconstrained models can be used safely for phonon calculations, though it is recommended to use looser convergence tolerances or enforce rotational averaging when performing free geometry optimizations with unconstrained models, especially with direct-force predictions."
    },
    {
      "id": "clai_00268",
      "type": "claim",
      "surface_form": "Elemental-SDNNFF produces accurate forces for Heusler alloys constituting 55 different elements and accurate predictions of phonon properties."
    },
    {
      "id": "clai_00413",
      "type": "claim",
      "surface_form": "Phonax efficiently predicts phonon dispersion relations and density of states for inorganic crystal materials."
    },
    {
      "id": "clai_00415",
      "type": "claim",
      "surface_form": "Augmenting a minimal 1×1×1 supercell training set with Hessian data yields more accurate phonon predictions than training on a larger 3×3×3 supercell alone."
    },
    {
      "id": "clai_00505",
      "type": "claim",
      "surface_form": "Out of 50 materials screened for electron-phonon calculations, 19 systems were found with Tc above 1 K, with ScMoC2 having the highest transition temperature at 15.97 K."
    },
    {
      "id": "clai_00609",
      "type": "claim",
      "surface_form": "Virtual Node Graph Neural Network (VGNN) enables graph neural networks to handle variable output dimensions by incorporating virtual nodes that resemble phonon dynamical matrices."
    },
    {
      "id": "clai_00610",
      "type": "claim",
      "surface_form": "Three virtual node approaches were developed: vector virtual nodes (VVN) outputting 3m Γ-phonon branches, matrix virtual nodes (MVN) with m² 3×3 matrices, and momentum-dependent matrix virtual nodes (k-MVN) for full band structure prediction."
    },
    {
      "id": "clai_00611",
      "type": "claim",
      "surface_form": "VGNN achieves direct prediction of Γ-phonon spectra and full phonon dispersion using only atomic coordinates as input without prior knowledge of interatomic forces."
    },
    {
      "id": "clai_00618",
      "type": "claim",
      "surface_form": "A Γ-phonon database containing phonon spectra for 146,323 Materials Project materials was generated using the MVN approach, with unit cell atom counts ranging from 1 to 444 atoms."
    },
    {
      "id": "clai_00619",
      "type": "claim",
      "surface_form": "The model was trained on a DFPT computational database containing phonon dispersion data for 1,521 crystalline inorganic materials."
    },
    {
      "id": "clai_00620",
      "type": "claim",
      "surface_form": "For very complicated materials, VVN-predicted phonons tend to have higher frequencies than ground truth, and prediction loss becomes larger as input materials become more complicated."
    },
    {
      "id": "clai_00622",
      "type": "claim",
      "surface_form": "While exact phonon band matching with DFPT is not always achieved, the model captures key features such as average frequency and band gaps."
    },
    {
      "id": "clai_00623",
      "type": "claim",
      "surface_form": "The Γ-phonon database exhibits a hyperbolic relationship between average frequency and average atomic mass following ω̄ = C m̄^(-1/2) with C ≈ 1993."
    },
