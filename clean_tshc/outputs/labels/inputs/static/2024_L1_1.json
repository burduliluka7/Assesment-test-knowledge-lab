{
  "cutoff": 2024,
  "generation_members": [
    {
      "id": "arti_00010",
      "type": "article",
      "surface_form": "Bridging scales with Machine Learning: From first principles statistical mechanics to continuum phase field computations to study order-disorder transitions in LixCoO2"
    },
    {
      "id": "clai_00386",
      "type": "claim",
      "surface_form": "A cluster expansion fitted to 333 DFT‑computed LiCoO₂ configurations using a genetic‑algorithm‑guided sparse regression achieves a root‑mean‑square error of 2.49 meV per primitive cell under 10‑fold cross‑validation and accurately reproduces formation energies, especially for configurations on or near the convex hull."
    },
    {
      "id": "clai_00387",
      "type": "claim",
      "surface_form": "Large‑scale DFT calculations estimate the coherent anti‑phase boundary energy between the η₁ = ½ and η₃ = ½ ordered LiCoO₂ rotational variants to be 30.9 mJ m⁻²."
    },
    {
      "id": "clai_00388",
      "type": "claim",
      "surface_form": "Integrable Deep Neural Networks trained on derivative (chemical‑potential) data accurately learn the high‑dimensional free‑energy density and chemical‑potential functions for LiₓCoO₂, achieving mean‑squared errors comparable to the reported minima and reproducing DFT formation energies with a mean absolute error below 5 meV atom⁻¹."
    },
    {
      "id": "clai_00389",
      "type": "claim",
      "surface_form": "Using the IDNN reduces the computational cost of generating free‑energy data for continuum models by approximately two orders of magnitude compared with direct DFT sampling."
    },
    {
      "id": "clai_00391",
      "type": "claim",
      "surface_form": "The presented scale‑bridging framework, linking DFT‑informed statistical mechanics to continuum phase‑field models via IDNN‑learned free‑energy functions, constitutes the first systematic implementation of this kind for LiCoO₂ cathodes."
    },
    {
      "id": "clai_00394",
      "type": "claim",
      "surface_form": "Inclusion of van der Waals interactions together with DFT+U improves the accuracy of predicted order‑disorder transition temperatures for LiCoO₂ relative to earlier first‑principles studies."
    },
    {
      "id": "clai_00395",
      "type": "claim",
      "surface_form": "Assuming the order‑disorder interface energy is half the anti‑phase boundary energy, the interface energy employed in phase‑field simulations is approximately 15.45 mJ m⁻²."
    },
    {
      "id": "clai_00397",
      "type": "claim",
      "surface_form": "Phase‑field simulations reproduce the lever‑rule mass fractions of ordered and disordered phases predicted by the Monte Carlo phase diagram after accounting for a slight shift in the order‑disorder boundaries from the IDNN free‑energy surface."
    },
    {
      "id": "clai_00398",
      "type": "claim",
      "surface_form": "Symmetry‑invariant polynomial features up to sixth order, constructed via the Reynolds operator, are used as inputs to the IDNN to respect the 384‑element symmetry group of the zig‑zag ordering."
    },
    {
      "id": "clai_00399",
      "type": "claim",
      "surface_form": "The IDNN framework is generalizable and can be applied to other intercalation compounds without modification of the network architecture."
    },
    {
      "id": "meth_00144",
      "type": "method",
      "surface_form": "Integrable Deep Neural Network (IDNN) for learning high‑dimensional free‑energy density and chemical potential functions"
    },
