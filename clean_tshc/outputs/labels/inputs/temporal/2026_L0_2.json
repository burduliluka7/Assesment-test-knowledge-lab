      "id": "clai_00461",
      "type": "claim",
      "surface_form": "SevenNet-0 achieves mean absolute errors of 24 meV/atom for energy, 0.067 eV/Å for force, and 0.65 GPa for stress on the test set."
    },
    {
      "id": "clai_00462",
      "type": "claim",
      "surface_form": "The parallelization algorithm restricts communication range between neighboring processors to the original cutoff radius (rc) rather than rc multiplied by message-passing steps."
    },
    {
      "id": "clai_00464",
      "type": "claim",
      "surface_form": "SevenNet-0 successfully generated amorphous Si3N4 structure with 112,000 atoms through melt-quench MD simulation, reproducing key structural features matching DFT reference data."
    },
    {
      "id": "clai_00466",
      "type": "claim",
      "surface_form": "SevenNet-0 shows improvements in energy and force accuracies compared to M3GNet (35 meV/atom, 0.072 eV/Å)."
    },
    {
      "id": "clai_00467",
      "type": "claim",
      "surface_form": "Architecture modifications reduced SevenNet-0 total model parameters from 16.24 million (GNoME) to 0.84 million."
    },
    {
      "id": "clai_00468",
      "type": "claim",
      "surface_form": "SevenNet exhibits nearly ideal strong-scaling performance as long as GPUs are fully utilized."
    },
    {
      "id": "clai_00469",
      "type": "claim",
      "surface_form": "Strong-scaling performance significantly declines with suboptimal GPU utilization, particularly for lightweight models or simulations with small numbers of atoms."
    },
    {
      "id": "clai_00471",
      "type": "claim",
      "surface_form": "A 60-ps MD simulation with 112,000 atoms using SevenNet-0 required 12.7 hours, approximately 0.1 ns per day."
    },
    {
      "id": "clai_00472",
      "type": "claim",
      "surface_form": "SevenNet interfaces with the LAMMPS package for MD simulations using TorchScript to integrate trained models."
    },
