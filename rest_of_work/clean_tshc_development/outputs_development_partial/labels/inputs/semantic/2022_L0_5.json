    {
      "id": "clai_00036",
      "type": "claim",
      "surface_form": "JARVIS‑Tools implements automatic k‑point convergence protocols that improve the precision of DFT calculations."
    },
    {
      "id": "clai_00053",
      "type": "claim",
      "surface_form": "The best one-step gradient-boosted tree regression model achieves 165±4 K MAE and 0.89 R² on the test set for melting temperature prediction."
    },
    {
      "id": "clai_00054",
      "type": "claim",
      "surface_form": "A two-step approach combining unsupervised clustering with supervised regression achieves 156±4 K MAE and 0.92 R², outperforming direct one-step supervised learning."
    },
    {
      "id": "clai_00059",
      "type": "claim",
      "surface_form": "Tree ensemble methods (gradient-boosted trees and random forest regression) substantially outperform linear models, which achieve MAE >240 K and RMSE >340 K, at least 100 K worse than non-linear approaches."
    },
    {
      "id": "clai_00078",
      "type": "claim",
      "surface_form": "Continuous-filter convolutional (cfconv) layers enable convolution on arbitrarily positioned inputs, overcoming the limitations of discrete filters that require grid-aligned data."
    },
    {
      "id": "clai_00132",
      "type": "claim",
      "surface_form": "The multiple‑tower architecture reduces the computational complexity of a propagation step from O(n²d²) to O(n²d²/k) and yields a 2× speedup for n=9, d=200, k=8."
    },
    {
      "id": "clai_00224",
      "type": "claim",
      "surface_form": "The AFLOWLIB data is accessible through a REST-API for standardized data exchange."
    },
    {
      "id": "clai_00311",
      "type": "claim",
      "surface_form": "Matbench v0.1 is a benchmark suite containing 13 supervised machine learning tasks (10 regression, 3 classification) for materials property prediction, with dataset sizes ranging from 312 to 132,752 samples."
    },
    {
      "id": "clai_00314",
      "type": "claim",
      "surface_form": "Automatminer is a fully-automated machine learning pipeline consisting of four stages (autofeaturization, cleaning, dimensionality reduction, and AutoML search) that requires no user intervention or hyperparameter tuning."
    },
    {
      "id": "clai_00318",
      "type": "claim",
      "surface_form": "Descriptor-based Automatminer and RF models have lower errors on small datasets but their improvement rates are shallower, with AutoML's advantage over conventional techniques narrowing as sample count increases and essentially lost near 10^5 samples."
    },
    {
      "id": "clai_00319",
      "type": "claim",
      "surface_form": "All algorithms exhibit a universal trend of decreasing relative errors as dataset size increases."
    },
    {
      "id": "clai_00320",
      "type": "claim",
      "surface_form": "For small datasets (<10^4 samples), inexpensive Automatminer presets (~1-5 minute training) retain the bulk of performance compared to expensive presets (24h+ training), with Express retaining 95% or more of the accuracy of more expensive presets at less than 50% of the computational cost on data-scarce tasks."
    },
    {
      "id": "clai_00322",
      "type": "claim",
      "surface_form": "Matbench provides a consistent evaluation framework using five-fold nested cross-validation on identical folds across all algorithms to minimize comparison bias, with datasets pre-cleaned to remove unphysical computed data and task-irrelevant experimental data."
    },
    {
      "id": "clai_00323",
      "type": "claim",
      "surface_form": "Automatminer source code and pre-processed Matbench tasks are open source and available online."
    },
    {
      "id": "clai_00504",
      "type": "claim",
      "surface_form": "The transfer learning approach iterates until model MAE is below 30 meV/atom."
    },
    {
      "id": "clai_00575",
      "type": "claim",
      "surface_form": "Using a loss function with adaptive prefactors that emphasize forces early and energies/virial later reduces the total training time to a few core‑hours for all test cases."
    },
    {
      "id": "clai_00663",
      "type": "claim",
      "surface_form": "AFLOW provides a standardized definition of Brillouin‑zone integration paths for all 14 Bravais lattices, filling a gap in the literature."
    },
    {
      "id": "clai_00675",
      "type": "claim",
      "surface_form": "AFLOW can predict alloy miscibility using Miedema and Hume‑Rothery mixing rules."
    },
