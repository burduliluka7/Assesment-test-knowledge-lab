    {
      "id": "arti_00025",
      "type": "article",
      "surface_form": "A Foundational Potential Energy Surface Dataset for Materials"
    },
    {
      "id": "clai_00021",
      "type": "claim",
      "surface_form": "The ConvLSTM model accurately predicts fracture patterns, crack‑length trends, and both mode‑I (tensile) and mode‑II (shear) loading responses across crystal orientations, closely matching atomistic molecular dynamics simulations, with only a minor discrepancy for the x100 orientation under mode‑II shear."
    },
    {
      "id": "clai_00022",
      "type": "claim",
      "surface_form": "The model predicts fracture toughness values that are comparable to those obtained from atomistic molecular dynamics simulations."
    },
    {
      "id": "clai_00023",
      "type": "claim",
      "surface_form": "A model trained exclusively on single‑crystal data generalizes to bicrystal and gradient‑orientation crystals, reproducing MD fracture patterns for small orientation differences, capturing overall crack paths for large orientation differences, and handling arbitrary geometry gradients."
    },
    {
      "id": "clai_00024",
      "type": "claim",
      "surface_form": "The ConvLSTM approach reduces computational cost dramatically compared with full molecular dynamics simulations, enabling rapid fracture predictions."
    },
    {
      "id": "clai_00025",
      "type": "claim",
      "surface_form": "Representing molecular dynamics results as image‑based geometric matrices preserves crystal orientation information and allows the neural network to learn spatiotemporal fracture behavior."
    },
    {
      "id": "clai_00029",
      "type": "claim",
      "surface_form": "Machine‑learning models trained on Classical Force‑field Inspired Descriptors (CFID) achieve high predictive accuracy for formation energies, exfoliation energies, band gaps, magnetic moments, refractive indices, dielectric constants, thermoelectric performance, and piezoelectric/infrared modes."
    },
    {
      "id": "clai_00142",
      "type": "claim",
      "surface_form": "Gaussian quadrature leads to abrupt energy jumps and fictitious minima when neighbor cut‑off radii change during large deformations."
    },
    {
      "id": "clai_00160",
      "type": "claim",
      "surface_form": "The DPLR model adds electrostatic energy to the total energy, with electrostatic energy calculated in Fourier space for modeling long-range interactions."
    },
    {
      "id": "clai_00187",
      "type": "claim",
      "surface_form": "Predicting forces as the negative gradient of the learned total energy guarantees energy conservation and rotation‑equivariant forces."
    },
    {
      "id": "clai_00217",
      "type": "claim",
      "surface_form": "The applied plane-wave kinetic energy cut-off (Ecut) is the largest recommended value among all species in the calculation, increased by a factor of 1.4."
    },
    {
      "id": "clai_00418",
      "type": "claim",
      "surface_form": "Fine‑tuning an energy model on a benzene vibrational spectrum improves spectrum predictions for unseen molecules such as toluene and phenol."
    },
    {
      "id": "clai_00419",
      "type": "claim",
      "surface_form": "A generalized energy model that includes external electric‑field dependence can predict polarization, Born effective charges, and polarizability, and improves energy and force MAE."
    },
    {
      "id": "clai_00487",
      "type": "claim",
      "surface_form": "The number of force components in the initial training set is more important than total configurations for obtaining generalizable models."
    },
    {
      "id": "clai_00509",
      "type": "claim",
      "surface_form": "A graph convolutional neural network predicts vibrational free energies with root‑mean‑square errors of 8.23 meV/atom (training), 11.34 meV/atom (validation) and 12.31 meV/atom (test), and its predictions for MgS and NaH polymorphs match DFT‑computed values across the 200–700 K range."
    },
    {
      "id": "clai_00521",
      "type": "claim",
      "surface_form": "The derived ACE formulas enable efficient evaluation of forces and magnetic torques."
    },
    {
      "id": "clai_00595",
      "type": "claim",
      "surface_form": "Higher degree representations (larger Lmax) better capture angular resolution and directional information critical for accurate force prediction and correlate with model expressivity."
    },
    {
      "id": "clai_00602",
      "type": "claim",
      "surface_form": "MACE evaluates roughly ten times faster than prior force‑field models for invariant (L=0) architectures and 4–5 times faster for equivariant (L=1,2) architectures, while delivering lower prediction errors."
    },
