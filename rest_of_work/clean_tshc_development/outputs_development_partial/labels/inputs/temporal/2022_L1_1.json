  "generation_members": [
    {
      "id": "arti_00028",
      "type": "article",
      "surface_form": "Machine learning a general purpose interatomic potential for silicon"
    },
    {
      "id": "auth_00059",
      "type": "author",
      "surface_form": "Gábor Csányi"
    },
    {
      "id": "auth_00116",
      "type": "author",
      "surface_form": "Albert P. Bartók"
    },
    {
      "id": "auth_00117",
      "type": "author",
      "surface_form": "James Kermode"
    },
    {
      "id": "auth_00118",
      "type": "author",
      "surface_form": "Noam Bernstein"
    },
    {
      "id": "clai_00226",
      "type": "claim",
      "surface_form": "For bulk elastic constants (B, C11, C12, C44) the GAP model achieves fractional errors of less than 10% relative to DFT, outperforming all other evaluated interatomic potentials."
    },
    {
      "id": "clai_00227",
      "type": "claim",
      "surface_form": "Surface energies of the (111), (110) and (100) silicon cleavage planes are predicted by GAP with errors of around 2% relative to DFT, which is comparable or better than other potentials."
    },
    {
      "id": "clai_00228",
      "type": "claim",
      "surface_form": "Formation energies of vacancy and interstitial point defects (hexagonal, tetrahedral, dumbbell) are predicted by GAP within 10% of DFT values, providing uniform accuracy across these defects."
    },
    {
      "id": "clai_00229",
      "type": "claim",
      "surface_form": "For extrapolative planar defects not included in the training set—specifically the (112) Σ3 grain boundary and unstable stacking fault energies on the (111) shuffle and glide planes—GAP errors remain within 20% of DFT, outperforming other models."
    },
    {
      "id": "clai_00230",
      "type": "claim",
      "surface_form": "Combining a simple repulsive pair potential with a many‑body SOAP‑kernel term in the GAP framework yields meV‑per‑atom accuracy for silicon energetics."
    },
    {
      "id": "clai_00232",
      "type": "claim",
      "surface_form": "Using the GAP model enables simulations that would be prohibitively expensive with DFT, such as finite‑temperature phase‑boundary calculations, liquid self‑diffusivity, amorphous silicon formation by slow quench, and dynamic brittle fracture."
    },
    {
      "id": "clai_00233",
      "type": "claim",
      "surface_form": "A training database of manageable size, constructed from DFT configurations covering relevant phases and defects, is sufficient to achieve high transferability of the GAP model across diverse silicon configurations."
    },
    {
      "id": "clai_00234",
      "type": "claim",
      "surface_form": "Benchmark comparisons show that the new GAP model yields lower errors than previous GAP models for silicon."
    },
    {
      "id": "clai_00235",
      "type": "claim",
      "surface_form": "The Smooth Overlap of Atomic Positions (SOAP) kernel captures the regularity of the silicon potential energy surface, leading to accurate interpolation within the sampled configuration space."
    },
    {
      "id": "clai_00676",
      "type": "claim",
      "surface_form": "The Gaussian approximation potential (GAP) enables atomistic simulations with close-to-DFT accuracy at computational costs many orders of magnitude lower than quantum-mechanical methods."
    },
    {
      "id": "clai_00677",
      "type": "claim",
      "surface_form": "Combined two-body, three-body, and SOAP many-body descriptors are necessary for GAP to achieve the accuracy limit imposed by force locality and make physically meaningful predictions; models using only subsets of descriptors produce unphysical structures during molecular dynamics simulations."
    },
    {
      "id": "clai_00678",
      "type": "claim",
      "surface_form": "GAP predicts diamond lattice parameter (3.539 Å) very close to DFT-LDA reference (3.532 Å), outperforming screened Tersoff potential (3.566 Å), with bulk modulus and elastic constants reasonably close to DFT reference values."
    },
    {
      "id": "clai_00679",
      "type": "claim",
      "surface_form": "GAP radial and angular distribution functions for liquid and amorphous carbon closely match DFT reference results, including peak locations, extents, and overall curve shapes."
    },
    {
      "id": "clai_00680",
      "type": "claim",
      "surface_form": "GAP recovers three- and four-membered rings that are key features of liquid and low-density amorphous carbon structures, which empirical potentials (Tersoff/Brenner) fail to predict."
    },
    {
      "id": "clai_00684",
      "type": "claim",
      "surface_form": "Empirical potentials (Tersoff/Brenner) cannot describe interlayer spacing in graphite due to short-range cutoff being less than c/2, provide poor description of carbon surfaces, and yield much lower surface energies than GAP and DFT for ta-C surfaces."
    },
    {
      "id": "clai_00685",
      "type": "claim",
      "surface_form": "Diamond exhibits strong force locality with force deviations vanishing practically at rfix = 5.5 Å, while graphite is highly nonlocal with larger force deviations that do not decay as rapidly."
    },
    {
      "id": "clai_00686",
      "type": "claim",
      "surface_form": "For amorphous carbon with 3.7 Å cutoff radius, the lowest achievable standard deviation of force components is approximately 1 eV/Å due to fundamental nonlocality limits, representing a maximum accuracy bound for any finite-range interatomic potential."
    },
    {
      "id": "clai_00687",
      "type": "claim",
      "surface_form": "DFT-based methods are practically limited to systems of a few hundred atoms, making generation of 8,000-atom amorphous carbon structures impossible with DFT-MD even on state-of-the-art supercomputers."
    },
