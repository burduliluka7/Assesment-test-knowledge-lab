{
  "cutoff": 2022,
  "generation_members": [
    {
      "id": "arti_00049",
      "type": "article",
      "surface_form": "The AFLOW Standard for High-Throughput Materials Science Calculations"
    },
    {
      "id": "clai_00216",
      "type": "claim",
      "surface_form": "The PBE functional combined with PAW potentials is the default exchange-correlation functional and potential combination for ICSD, Binary Alloy, and Heusler databases."
    },
    {
      "id": "clai_00217",
      "type": "claim",
      "surface_form": "The applied plane-wave kinetic energy cut-off (Ecut) is the largest recommended value among all species in the calculation, increased by a factor of 1.4."
    },
    {
      "id": "clai_00218",
      "type": "claim",
      "surface_form": "DFT+U corrections are applied to the entire ICSD database and certain Heusler database entries containing O, S, Se, and F elements, but not to the Binary Alloy database."
    },
    {
      "id": "clai_00219",
      "type": "claim",
      "surface_form": "Specific Ueff parameters are defined for d-block elements (Table 4) and U, J parameters for f-block elements (Table 5) to correct self-interaction error in DFT+U calculations, with values ranging from 1.9 eV (In) to 7.5 eV (Zn)."
    },
    {
      "id": "clai_00220",
      "type": "claim",
      "surface_form": "The first RELAX calculation is performed in collinear spin-polarized fashion with initial magnetic moments set to 1.0 µB per atom, and spin polarization is turned off in subsequent calculations if magnetization is below 0.025 µB/atom."
    },
    {
      "id": "clai_00221",
      "type": "claim",
      "surface_form": "Electronic convergence criteria are δEelec = 10⁻⁵ eV and ionic convergence criteria are δEion = 10⁻⁴ eV for Elements database entries, while all other databases use δEelec = 10⁻³ eV and δEion = 10⁻² eV."
    },
    {
      "id": "clai_00222",
      "type": "claim",
      "surface_form": "Following the AFLOW standard enables materials science researchers to reproduce AFLOWLIB consortium results and make direct comparisons of properties between different materials for identifying trends and formulating design rules."
    },
    {
      "id": "clai_00223",
      "type": "claim",
      "surface_form": "BANDS calculations use 128 k-points per segment for single element structures and 20 k-points for compounds along high-symmetry paths."
    },
    {
      "id": "clai_00224",
      "type": "claim",
      "surface_form": "The AFLOWLIB data is accessible through a REST-API for standardized data exchange."
    },
    {
      "id": "futu_00061",
      "type": "future_topic",
      "surface_form": "Completion of Quantum ESPRESSO software integration"
    },
    {
      "id": "futu_00062",
      "type": "future_topic",
      "surface_form": "Standard parameter values for k-point grid density"
    },
    {
      "id": "meth_00355",
      "type": "method",
      "surface_form": "AFLOW high-throughput DFT calculation protocol"
    }
  ],
