    },
    {
      "id": "clai_00449",
      "type": "claim",
      "surface_form": "GNoME discovered over 2.2 million new stable inorganic materials and more than 45 000 new crystal prototypes, an order‑of‑magnitude increase over prior discovery efforts."
    },
    {
      "id": "clai_00454",
      "type": "claim",
      "surface_form": "LLM‑based agents such as HoneyComb, LLMatDesign, ChatMOF, MatAgent, and MatPilot have been developed to automate literature search, hypothesis generation, synthesis planning, and experimental verification in materials science."
    },
    {
      "id": "clai_00455",
      "type": "claim",
      "surface_form": "Existing materials datasets are heavily skewed toward inorganic atomistic systems, with limited coverage of polymers, composites, and mesoscale phenomena, creating a critical data imbalance for foundation‑model training."
    },
    {
      "id": "clai_00456",
      "type": "claim",
      "surface_form": "Future research should focus on scalable pretraining, continual learning, data governance, trustworthiness, and incorporation of physics‑informed constraints such as equivariance, quantum‑mechanical symmetries, and thermodynamic principles to improve accuracy, interpretability, and trustworthiness of foundation models."
    },
    {
      "id": "clai_00457",
