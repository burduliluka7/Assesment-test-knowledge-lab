    },
    {
      "id": "clai_00263",
      "type": "claim",
      "surface_form": "DScribe provides a library of descriptors for machine learning in materials science."
    },
    {
      "id": "clai_00311",
      "type": "claim",
      "surface_form": "Matbench v0.1 is a benchmark suite containing 13 supervised machine learning tasks (10 regression, 3 classification) for materials property prediction, with dataset sizes ranging from 312 to 132,752 samples."
    },
    {
      "id": "clai_00340",
      "type": "claim",
      "surface_form": "Computing the frozen‑framework PES descriptors for 5997 Materials Project structures required seven days on a 48‑core CPU with two RTX 6000 GPUs, comparable to the time needed for ML‑driven MD on 100 materials."
    },
    {
      "id": "clai_00351",
      "type": "claim",
      "surface_form": "Artificial intelligence has transformed multiscale modeling by linking atomic, mesoscale, and continuum scales, delivering improved accuracy and reduced computational cost compared with traditional methods."
    },
    {
      "id": "clai_00401",
      "type": "claim",
      "surface_form": "ML-based simulation can achieve comparable fidelity to direct numerical simulation while being considerably faster in computation time, with convolutional neural networks producing high-fidelity estimation of materials microstructure response with multiple orders of magnitude faster computation."
    },
    {
      "id": "clai_00407",
      "type": "claim",
      "surface_form": "Physics-informed machine learning and transfer learning can reduce the need for large datasets while maintaining prediction accuracy and performance of ML models."
