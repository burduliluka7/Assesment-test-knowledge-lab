    {
      "id": "clai_00154",
      "type": "claim",
      "surface_form": "The DeepPot-SE descriptor is continuous up to the second-order derivative in its domain, unlike the local frame descriptor which is not smooth at the cutoff radius and when exchanging the order of two nearest neighbors."
    },
    {
      "id": "clai_00155",
      "type": "claim",
      "surface_form": "None of the tested descriptors outperforms the others in terms of accuracy across all datasets."
    },
    {
      "id": "clai_00332",
      "type": "claim",
      "surface_form": "All evaluated descriptors (MPE, FV‑connected, FV‑disconnected) achieve ranking scores above those of a random‑guess classifier, demonstrating predictive capability for ionic conductivity."
    },
    {
      "id": "clai_00334",
      "type": "claim",
      "surface_form": "The Ξ descriptor screening increases the proportion of room‑temperature superionic candidates from ~7% in an unbiased sample to 55% in the top‑100 Ξ‑ranked list, an ~8‑fold improvement."
    },
    {
      "id": "clai_00347",
      "type": "claim",
      "surface_form": "Alternative ranking models (logistic regression L1/L2 and CatBoost) trained on PES descriptors, matminer descriptors, or their combination do not surpass the simple Ξ descriptor in predictive performance."
    },
    {
      "id": "clai_00349",
      "type": "claim",
      "surface_form": "Both connected and disconnected versions of the FV descriptor at a 0.5 eV threshold show systematic relationships with conductivity and activation‑energy labels in the Kahle2020 simulated dataset and the Laskowski2023 experimental dataset."
    },
    {
      "id": "clai_00421",
      "type": "claim",
      "surface_form": "The QR‑based reparameterization used in D4FT preserves the orthonormal constraints of Kohn‑Sham orbitals, making the search space equivalent to the original orthogonal function space, as proved in Proposition 3.1, and can be interpreted as projected gradient descent on the orthogonal constraint set."
    },
