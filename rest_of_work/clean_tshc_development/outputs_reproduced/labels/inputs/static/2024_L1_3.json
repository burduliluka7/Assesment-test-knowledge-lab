  "generation_members": [
    {
      "id": "arti_00029",
      "type": "article",
      "surface_form": "Universal Machine Learning Kohn-Sham Hamiltonian for Materials"
    },
    {
      "id": "clai_00191",
      "type": "claim",
      "surface_form": "The universal HamGNN model achieves a mean absolute error of 5.4 meV for the real‑space Hamiltonian matrix on the test set after the first round of training."
    },
    {
      "id": "clai_00193",
      "type": "claim",
      "surface_form": "The universal HamGNN model accurately predicts the energy band structures and charge densities of complex multi‑element crystals (e.g., Hf2Zr9Ta6Ti5Nb5B54, HfTaTiB4MoC4, K3Ba3Li2Al4B6O20F), matching DFT results."
    },
    {
      "id": "clai_00196",
      "type": "claim",
      "surface_form": "High‑throughput screening of 188,722 GeNOME crystals with the universal model identifies 21,973 insulators (3,940 direct‑gap) and 5,109 flat‑band materials, nearly doubling the entries in the Materials Flatband Database."
    },
    {
      "id": "clai_00197",
      "type": "claim",
      "surface_form": "Using the universal HamGNN model reduces computational cost by several orders of magnitude compared with DFT (e.g., 0.33 core·hours versus 181 core·hours for a large MOF) while preserving accuracy of band gaps and charge‑density differences."
    },
    {
      "id": "clai_00198",
      "type": "claim",
      "surface_form": "A two‑step training procedure—first minimizing real‑space Hamiltonian error, then adding orbital‑energy error at random k‑points—is essential to obtain a truly universal Hamiltonian model."
    },
    {
      "id": "clai_00199",
      "type": "claim",
      "surface_form": "Incorporating orbital‑energy loss in a second fine‑tuning round markedly improves band‑structure predictions, yielding energy bands and Fermi surfaces that closely match DFT calculations for the test set."
    },
    {
      "id": "clai_00200",
      "type": "claim",
      "surface_form": "The universal HamGNN model generalizes to crystals containing more than five distinct elements and to any element supported by the OpenMX PBE pseudopotential library, effectively covering the entire periodic table."
    },
    {
      "id": "futu_00052",
