    {
      "id": "arti_00015",
      "type": "article",
      "surface_form": "CHGNet: Pretrained universal neural network potential for charge-informed atomistic modeling"
    },
    {
      "id": "clai_00065",
      "type": "claim",
      "surface_form": "CHGNet achieves state-of-the-art performance on the Matbench Discovery benchmark, outperforming eight other submitted models."
    },
    {
      "id": "clai_00066",
      "type": "claim",
      "surface_form": "On the Materials Project Trajectory test set, CHGNet trained with magnetic moment labels attains mean absolute errors of 30 meV/atom for energy, 77 meV/Å for forces, 0.348 GPa for stress, and 0.032 µB for magnetic moments."
    },
    {
      "id": "clai_00067",
      "type": "claim",
      "surface_form": "CHGNet molecular dynamics simulations of Li superionic conductors reproduce room‑temperature ionic conductivities and activation energies within the error bars of AIMD, correctly distinguishing faster from slower conductors."
    },
    {
      "id": "clai_00068",
      "type": "claim",
      "surface_form": "CHGNet integrates magnetic moment labels as a proxy for atomic charge, enabling inference of atomic charges and accurate differentiation of oxidation states such as V³⁺/V⁴⁺ and Fe²⁺/Fe³⁺."
    },
    {
      "id": "clai_00069",
      "type": "claim",
      "surface_form": "In charge‑informed molecular dynamics of Li₀.₅MnO₂ at 1100 K, CHGNet predicts the emergence of Mn²⁺ after ~0.8 ns, coinciding with a ~50 meV/oxygen reduction in potential energy and the formation of a spinel‑like phase, indicating a correlation between charge disproportionation and phase transformation."
    },
    {
      "id": "clai_00072",
      "type": "claim",
      "surface_form": "Fine‑tuning the pretrained CHGNet on the Li‑Fe‑P‑O chemical space reduces the test error from 23 meV/atom to 15 meV/atom."
    },
    {
      "id": "clai_00074",
      "type": "claim",
      "surface_form": "CHGNet enables nanosecond‑scale molecular dynamics simulations of garnet Li₃La₃Te₂O₁₂, yielding lithium self‑diffusion coefficients with quantified uncertainty."
    },
    {
      "id": "clai_00075",
      "type": "claim",
      "surface_form": "Using magnetic moments as a charge proxy does not strictly ensure global charge neutrality in CHGNet predictions."
    },
    {
      "id": "clai_00076",
      "type": "claim",
      "surface_form": "The Materials Project Trajectory dataset used to pre‑train CHGNet contains approximately 1.58 million atomic configurations spanning 94 elements, with magnetic moment labels for 76 elements, providing comprehensive chemical coverage."
    },
    {
      "id": "clai_00260",
      "type": "claim",
      "surface_form": "CHGNet uniquely includes electronic effects of valences by explicitly embedding magnetic moments on the vector representation of each atom, enabling charge-informed atomistic simulations."
    },
