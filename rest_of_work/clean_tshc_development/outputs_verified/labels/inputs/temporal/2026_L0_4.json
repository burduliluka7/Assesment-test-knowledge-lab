  "generation_members": [
    {
      "id": "arti_00050",
      "type": "article",
      "surface_form": "Machine Learning Interatomic Potentials: A Review and Framework for Understanding MLIPs"
    },
    {
      "id": "clai_00251",
      "type": "claim",
      "surface_form": "FastCHGNet trains in 1.5 hours using 32 GPUs compared to 8.3 days on a single A100 GPU for the original CHGNet model."
    },
    {
      "id": "clai_00252",
      "type": "claim",
      "surface_form": "MLIPs map atomic configurations to total energy and provide forces and stresses as analytical derivatives of the potential energy surface."
    },
    {
      "id": "clai_00254",
      "type": "claim",
      "surface_form": "Approximately 40% of the UK's academic HPC was spent on DFT calculations in a recent year, most of which was AIMD."
    },
    {
      "id": "clai_00255",
      "type": "claim",
      "surface_form": "EquiformerV2-OMAT24 achieves the best performance on the MatBench leaderboard as of this writing."
    },
    {
      "id": "clai_00256",
      "type": "claim",
      "surface_form": "Each cataloged DFT structure provides one energy and 3N forces (N = number of atoms) for training universal MLIPs."
    },
    {
      "id": "clai_00257",
      "type": "claim",
      "surface_form": "Pre-trained targeted MLIPs for specific systems can be found on the NIST Interatomic Potentials Repository and OpenKIM."
    },
    {
      "id": "clai_00258",
      "type": "claim",
      "surface_form": "CHGNet achieves test mean absolute errors of 29 meV/atom for energy, 70 meV/Angstrom for force, and 0.308 GPa for stress."
    },
    {
      "id": "clai_00259",
      "type": "claim",
      "surface_form": "M3GNet achieves test mean absolute errors of 35 meV/atom for energy, 72 meV/Angstrom for force, and 0.41 GPa for stress."
    },
    {
      "id": "clai_00260",
      "type": "claim",
      "surface_form": "CHGNet uniquely includes electronic effects of valences by explicitly embedding magnetic moments on the vector representation of each atom, enabling charge-informed atomistic simulations."
    },
    {
      "id": "clai_00261",
      "type": "claim",
      "surface_form": "CHGNet achieved the lowest formation energy MAE at 81 meV/atom, while all other models had MAEs of 129 meV/atom or higher."
    },
    {
      "id": "clai_00262",
      "type": "claim",
      "surface_form": "MACE-MP0 performed best for discovering new stable materials with classification F1 score of 0.67, followed by CHGNet (0.61) and M3GNet (0.57)."
    },
    {
      "id": "clai_00263",
      "type": "claim",
      "surface_form": "DScribe provides a library of descriptors for machine learning in materials science."
    },
    {
      "id": "clai_00264",
      "type": "claim",
      "surface_form": "Matminer is an open source toolkit for materials data mining."
    },
    {
      "id": "clai_00265",
      "type": "claim",
      "surface_form": "ColabFit Exchange provides open-access datasets for data-driven interatomic potentials."
    },
    {
      "id": "clai_00267",
      "type": "claim",
      "surface_form": "MACE and grACE packages provide excellent scaling with number of elements while achieving high accuracy."
    },
    {
      "id": "clai_00268",
      "type": "claim",
      "surface_form": "Elemental-SDNNFF produces accurate forces for Heusler alloys constituting 55 different elements and accurate predictions of phonon properties."
    },
    {
      "id": "clai_00270",
      "type": "claim",
      "surface_form": "MACE-OFF3 uses only short-range interactions yet achieves improved performance on benchmark molecular simulation properties compared to ANI."
    },
    {
      "id": "clai_00273",
      "type": "claim",
      "surface_form": "M3GNet is an extension of MEGNet model to include 3-body interactions, explicit atomic coordinates, and 3×3 crystal lattice matrix."
    },
    {
      "id": "clai_00275",
      "type": "claim",
      "surface_form": "For MLIPs, the loss function is usually a weighted sum of RMSEs on forces and total energy."
    },
    {
      "id": "clai_00278",
      "type": "claim",
      "surface_form": "None of the three U-MLIPs (M3GNet, CHGNet, MACE-MP0) could accurately reproduce mixing energies of metallic binary alloys in adequate agreement with DFT results."
    },
    {
      "id": "clai_00280",
      "type": "claim",
      "surface_form": "There exists a continuum of approaches between pure PBPs (physics-derived with almost no fitting parameters) and pure MLIPs (purely numerical fit with almost no intuitive guidance)."
    },
    {
      "id": "clai_00281",
      "type": "claim",
      "surface_form": "MLIPs require substantial training data to learn the physics of the system, though this is becoming easier to meet as ab initio data becomes more plentiful and standardized."
    },
    {
      "id": "clai_00282",
      "type": "claim",
      "surface_form": "MLIPs are straightforward to iteratively improve by adding more training data, whereas improving PBPs often requires fundamental changes to underlying functional forms."
    },
    {
      "id": "clai_00283",
      "type": "claim",
      "surface_form": "DeepMD represents local atomic environment as embedding vectors constructed by neural networks based on atom distances, angles, and types."
    },
    {
      "id": "clai_00284",
      "type": "claim",
      "surface_form": "Element-specific weights allow constant-size AEF vectors irrespective of the number of chemical elements."
    },
    {
      "id": "clai_00286",
      "type": "claim",
      "surface_form": "Most MLIPs are trained on limited domains (1-10 elements) and cannot extrapolate to new elements or local structures not in training data."
    },
    {
      "id": "clai_00287",
      "type": "claim",
      "surface_form": "AIMNet2 targets molecular and macromolecular structures applicable to species containing up to 14 chemical elements in neutral and charged states."
    },
    {
      "id": "clai_00288",
      "type": "claim",
      "surface_form": "U-MLIPs typically cover over 50 elements and may accurately model solids, liquids, and molecular structures."
    },
    {
      "id": "clai_00289",
      "type": "claim",
      "surface_form": "M3GNet potential covers 89 elements with no particular constraints on applicability, though training has strong bias toward solid phases."
    },
    {
      "id": "clai_00290",
      "type": "claim",
      "surface_form": "ANI potential was expanded in 2020 to include S, Cl, and F elements, covering approximately 90% of drug-like molecules."
    },
    {
      "id": "clai_00291",
      "type": "claim",
      "surface_form": "AIMNet2 extends ANI to include up to 14 elemental species with additional vdW and electrostatic correction terms."
    },
    {
      "id": "clai_00292",
      "type": "claim",
      "surface_form": "First published U-MLIPs with broad periodic table applicability came nearly simultaneously in early 2022."
    },
    {
      "id": "clai_00293",
      "type": "claim",
      "surface_form": "U-MLIPs generally have low energy and force errors compared to their ab initio training data."
    },
    {
      "id": "clai_00294",
      "type": "claim",
      "surface_form": "Pre-relaxing hypothetical structures with U-MLIP before ab initio calculations resulted in approximately 3× time savings compared to running ab initio on un-relaxed structures."
    },
    {
      "id": "clai_00295",
      "type": "claim",
      "surface_form": "An MLIP trained on pristine crystalline phases may not be appropriate for studying amorphous phases of the same material."
    },
    {
      "id": "clai_00296",
      "type": "claim",
      "surface_form": "Good agreement on target properties provides greater confidence in U-MLIP than just similar energies and forces on select structures."
    },
    {
      "id": "clai_00299",
      "type": "claim",
      "surface_form": "Including magnetic moments in CHGNet training led to error reductions of 1-10% for energy, force, and stress compared to not including magnetic moments."
    },
    {
      "id": "clai_00302",
      "type": "claim",
      "surface_form": "MLIPs are not fundamentally limited to specific system types (metallic, ionic, reactive vs. nonreactive), unlike distinctions that were essential for PBPs."
    },
    {
      "id": "clai_00305",
      "type": "claim",
      "surface_form": "Universal MLIPs attempt to cover 10-100 elements under varying levels of constraints."
    },
    {
      "id": "clai_00307",
      "type": "claim",
      "surface_form": "Random cross-validation or k-fold CV are reasonable for test data if the data is not highly correlated."
    },
    {
      "id": "clai_00309",
      "type": "claim",
      "surface_form": "U-MLIPs systematically underpredict energies and forces due to softening of the potential energy surface, attributed to biased sampling in training datasets from DFT ionic relaxations near local PES minima."
    },
    {
      "id": "clai_00310",
      "type": "claim",
      "surface_form": "Some of the best-performing MLIPs are trained separately on energies and forces and are non-conservative, with forces not directly calculated by differentiating the PES."
    },
    {
